APP_ENV=docker
LOG_LEVEL=info
FEATURE_ENABLE_STATS=true

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=5s

POSTGRES_DB=prreviewer
POSTGRES_USER=pruser
POSTGRES_PASSWORD=prpass
POSTGRES_HOST=db
POSTGRES_PORT=5432

DB_DSN=postgres://pruser:prpass@db:5432/prreviewer?sslmode=disable
TEST_DB_DSN=postgres://pruser:prpass@localhost:5432/prreviewer?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m


E2E_BASE_URL=http://localhost:8080